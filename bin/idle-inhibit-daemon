#!/usr/bin/env python3
"""Own org.freedesktop.ScreenSaver and drive Omarchy stay-awake while video plays.

Ownership semantics (see also Service.qml):
- exit 0: the name is held by a sibling copy of this daemon (QML keeps
  retrying gently; a dying sibling loses the name within seconds)
- exit 4 (EXIT_FOREIGN): the name is held by a genuinely foreign owner,
  e.g. a future native Omarchy implementation; QML stands down for this
  shell's lifetime
This process also refuses to outlive its environment: a 3s parent-liveness
watchdog exits on shell death, and a 30s heartbeat re-syncs state and
exits when the stdout reader is gone. Claim/stay-awake state files are
only cleared after actually owning the name (on_name_acquired).
"""

from __future__ import annotations

import json
import os
import random
import signal
import stat
import sys
from dataclasses import dataclass
from pathlib import Path

import gi

gi.require_version("Gio", "2.0")
gi.require_version("GLib", "2.0")
from gi.repository import Gio, GLib

SCREENSAVER_NAME = "org.freedesktop.ScreenSaver"
SCREENSAVER_PATHS = ("/org/freedesktop/ScreenSaver", "/ScreenSaver")
MAX_INHIBITS = 1024
MAX_STRING = 256
# Distinct exit code for "the name is held by a foreign owner". QML treats
# this as the only permanent stand-down; exit 0 (sibling) keeps retrying.
EXIT_FOREIGN = 4
TRUSTED_PYTHON = "/usr/bin/python3"
TRUSTED_PREFIXES = ("/usr/bin/", "/usr/lib/")

SCREENSAVER_XML = """
<node>
  <interface name="org.freedesktop.ScreenSaver">
    <method name="Inhibit">
      <arg direction="in" type="s" name="application_name"/>
      <arg direction="in" type="s" name="reason_for_inhibit"/>
      <arg direction="out" type="u" name="cookie"/>
    </method>
    <method name="UnInhibit">
      <arg direction="in" type="u" name="cookie"/>
    </method>
  </interface>
</node>
"""


def state_dir() -> Path:
    override = os.environ.get("OMARCHY_IDLE_INHIBIT_STATE_DIR")
    return Path(override) if override else Path.home() / ".local/state/omarchy/indicators"


def too_long(value: object) -> bool:
    return not isinstance(value, str) or len(value) > MAX_STRING


def trusted_interpreter(path: str) -> str | None:
    """Absolute, root-owned interpreter resolving under /usr/bin or /usr/lib.

    Symlink permission bits are unused on Linux (typically 777). The resolved
    regular file must not be group- or world-writable. PATH is never consulted.
    """
    if not path or not os.path.isabs(path):
        return None
    try:
        link = os.lstat(path)
    except OSError:
        return None
    if link.st_uid != 0:
        return None
    if not stat.S_ISLNK(link.st_mode) and (link.st_mode & 0o022):
        return None
    real = os.path.realpath(path)
    if not real.startswith(TRUSTED_PREFIXES):
        return None
    try:
        body = os.stat(real)
    except OSError:
        return None
    if not stat.S_ISREG(body.st_mode) or body.st_uid != 0 or body.st_mode & 0o022:
        return None
    return real


def check_interpreter() -> int:
    resolved = trusted_interpreter(TRUSTED_PYTHON)
    running = trusted_interpreter(os.path.realpath(sys.executable))
    if not resolved or not running:
        return 1
    sys.stdout.write(resolved + "\n")
    sys.stdout.flush()
    return 0


@dataclass
class Hold:
    sender: str
    app: str
    reason: str


class IdleInhibitDaemon:
    def __init__(self) -> None:
        self.loop = GLib.MainLoop()
        self.connection: Gio.DBusConnection | None = None
        self.holds: dict[int, Hold] = {}
        self.cookie = random.randrange(1, 2**32)
        self.acquired = False
        self.stopping = False
        self.exit_code = 0
        self.streams_detached = False
        self.watch_pid = self._init_watch_pid()

    @property
    def held(self) -> bool:
        return bool(self.holds)

    def stay_path(self) -> Path:
        return state_dir() / "stay-awake"

    def claim_path(self) -> Path:
        return state_dir() / "idle-inhibit"

    def status(self) -> dict:
        return {
            "held": self.held,
            "count": len(self.holds),
            "holders": [
                {"cookie": cookie, "sender": hold.sender, "app": hold.app, "reason": hold.reason}
                for cookie, hold in sorted(self.holds.items())
            ],
            "stayAwake": self.stay_path().exists(),
            "auto": self.claim_path().exists(),
            "screensaverName": self.acquired,
        }

    def _detach_streams(self) -> None:
        """send stdout/stderr to devnull after a broken pipe so the interpreter
        shutdown flush cannot turn a graceful exit (0) into exit 120."""
        if self.streams_detached:
            return
        try:
            devnull = open(os.devnull, "w", encoding="utf-8")  # noqa: SIM115 - process-lifetime handle
        except OSError:
            return
        self.streams_detached = True
        sys.stdout = devnull
        sys.stderr = devnull

    def publish(self) -> None:
        text = json.dumps(self.status(), separators=(",", ":")) + "\n"
        try:
            sys.stdout.write(text)
            sys.stdout.flush()
        except OSError:
            # Our reader (the shell plugin instance) is gone; a newer copy
            # should take over. Stand down instead of keeping the name.
            self.log("stdout closed; standing down")
            self._detach_streams()
            self.request_stop()

    def publish_heartbeat(self) -> None:
        try:
            sys.stdout.write('{"type":"heartbeat"}\n')
            sys.stdout.flush()
        except OSError:
            self.log("stdout closed; standing down")
            self._detach_streams()
            self.request_stop()

    def log(self, message: str) -> None:
        try:
            sys.stderr.write(f"idle-inhibit: {message[:MAX_STRING]}\n")
            sys.stderr.flush()
        except OSError:
            self._detach_streams()

    def read_claim(self) -> tuple[int, int, int] | None:
        try:
            data = json.loads(self.claim_path().read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError, json.JSONDecodeError):
            return None
        if not isinstance(data, dict):
            return None
        dev, ino, pid = data.get("dev"), data.get("ino"), data.get("pid")
        if not (isinstance(dev, int) and isinstance(ino, int) and isinstance(pid, int)):
            return None
        return dev, ino, pid

    def write_claim(self, dev: int, ino: int) -> None:
        path = self.claim_path()
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_name("idle-inhibit.tmp")
        tmp.write_text(json.dumps({"dev": dev, "ino": ino, "pid": os.getpid()}), encoding="utf-8")
        tmp.replace(path)

    def stay_matches(self, claim: tuple[int, int, int]) -> bool:
        try:
            info = self.stay_path().stat()
        except OSError:
            return False
        return (info.st_dev, info.st_ino) == claim[:2]

    def claim_is_ours(self, claim: tuple[int, int, int] | None) -> bool:
        """Only the daemon that wrote a claim may delete it: claims are shared
        files, and a losing sibling must never wipe a serving copy's state."""
        return claim is not None and claim[2] == os.getpid()

    def create_owned_stay(self) -> None:
        stay = self.stay_path()
        try:
            fd = os.open(stay, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
            os.close(fd)
        except FileExistsError:
            return
        info = os.stat(stay)
        self.write_claim(info.st_dev, info.st_ino)

    def drop_owned_stay(self, claim: tuple[int, int]) -> None:
        if self.stay_matches(claim):
            self.stay_path().unlink(missing_ok=True)
        self.claim_path().unlink(missing_ok=True)

    def clear_stale_claim(self) -> None:
        claim = self.read_claim()
        if claim and self.stay_matches(claim):
            self.stay_path().unlink(missing_ok=True)
        self.claim_path().unlink(missing_ok=True)
        self.claim_path().with_name("idle-inhibit.tmp").unlink(missing_ok=True)

    def sync_stay_awake(self) -> None:
        state_dir().mkdir(parents=True, exist_ok=True)
        stay = self.stay_path()
        claim = self.read_claim()
        owned = claim is not None and claim[2] == os.getpid() and self.stay_matches(claim)

        if self.held:
            if owned:
                return
            if claim is not None and self.claim_is_ours(claim):
                # Our claim, but the stay file changed underneath it (the user
                # recreated it): the claim is stale, the file is the user's.
                self.claim_path().unlink(missing_ok=True)
                if stay.exists():
                    return
            if claim is not None and claim[2] != os.getpid():
                # Foreign claim: we own the bus now, so adopt the state. If
                # their claim still matches the stay inode it was created by
                # the dead copy we replaced (always safe to remove); a bare
                # user stay file is left untouched.
                if self.stay_matches(claim):
                    self.stay_path().unlink(missing_ok=True)
                self.claim_path().unlink(missing_ok=True)
                if stay.exists():
                    return
            elif stay.exists():
                return
            self.create_owned_stay()
            return

        if self.claim_is_ours(claim):
            self.drop_owned_stay(claim)

    def allocate_cookie(self) -> int | None:
        if len(self.holds) >= MAX_INHIBITS:
            return None
        self.cookie += 1
        return self.cookie

    def inhibit(self, sender: str, app: str, reason: str) -> int | None:
        cookie = self.allocate_cookie()
        if cookie is None:
            return None
        self.holds[cookie] = Hold(sender=sender, app=app, reason=reason)
        self.sync_stay_awake()
        self.publish()
        return cookie

    def uninhibit(self, cookie: int, sender: str) -> str | None:
        hold = self.holds.get(cookie)
        if hold is None:
            return None
        if hold.sender != sender:
            return "org.freedesktop.DBus.Error.AccessDenied"
        del self.holds[cookie]
        self.sync_stay_awake()
        self.publish()
        return None

    def drop_sender(self, sender: str) -> None:
        kept = {cookie: hold for cookie, hold in self.holds.items() if hold.sender != sender}
        if len(kept) == len(self.holds):
            return
        self.holds = kept
        self.sync_stay_awake()
        self.publish()

    def on_method(self, connection, sender, object_path, interface_name, method_name, parameters, invocation):
        try:
            if method_name == "Inhibit":
                unpacked = parameters.unpack()
                if len(unpacked) != 2 or too_long(unpacked[0]) or too_long(unpacked[1]):
                    invocation.return_dbus_error(
                        "org.freedesktop.DBus.Error.InvalidArgs",
                        "application_name and reason_for_inhibit must be at most 256 characters",
                    )
                    return
                cookie = self.inhibit(sender, unpacked[0], unpacked[1])
                if cookie is None:
                    invocation.return_dbus_error(
                        "org.freedesktop.DBus.Error.LimitsExceeded",
                        "too many idle inhibits",
                    )
                    return
                invocation.return_value(GLib.Variant("(u)", (cookie,)))
                return
            if method_name == "UnInhibit":
                (cookie,) = parameters.unpack()
                denied = self.uninhibit(int(cookie), sender)
                if denied:
                    invocation.return_dbus_error(denied, "cookie not owned by sender")
                    return
                invocation.return_value(None)
                return
            invocation.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", method_name)
        except Exception as error:  # noqa: BLE001 - must not hang the D-Bus caller
            invocation.return_dbus_error("org.freedesktop.DBus.Error.Failed", str(error)[:MAX_STRING])

    def on_name_owner_changed(self, connection, sender_name, object_path, interface_name, signal_name, parameters):
        name, _old, new_owner = parameters.unpack()
        if new_owner == "" and str(name).startswith(":"):
            self.drop_sender(name)

    def register_objects(self, connection: Gio.DBusConnection) -> None:
        if self.connection is not None:
            return
        self.connection = connection
        info = Gio.DBusNodeInfo.new_for_xml(SCREENSAVER_XML).interfaces[0]
        for path in SCREENSAVER_PATHS:
            connection.register_object(path, info, self.on_method, None, None)
        connection.signal_subscribe(
            "org.freedesktop.DBus",
            "org.freedesktop.DBus",
            "NameOwnerChanged",
            "/org/freedesktop/DBus",
            None,
            Gio.DBusSignalFlags.NONE,
            self.on_name_owner_changed,
        )

    def on_bus_acquired(self, connection, name) -> None:
        self.register_objects(connection)

    def on_name_acquired(self, connection, name) -> None:
        self.acquired = True
        # Clear only once we actually own the name: a copy that loses the
        # startup race must not destroy the stay-awake state the serving
        # daemon is relying on.
        self.clear_stale_claim()
        self.publish()

    def _owner_is_sibling(self, connection, name: str) -> bool:
        """True when the bus name is held by another copy of this daemon.

        Decides between "sibling copy serving fine" (exit 0, the QML layer
        keeps retrying gently) and "genuinely foreign owner, e.g. a future
        native Omarchy implementation" (exit EXIT_FOREIGN, QML stands down
        for the lifetime of the shell). Unclassifiable resolves to foreign,
        which is the conservative upstream behavior.
        """
        marker = os.path.basename(sys.argv[0]) if sys.argv else ""
        try:
            owner = connection.call_sync(
                "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                "GetNameOwner", GLib.Variant("(s)", (name,)),
                GLib.VariantType("(s)"), Gio.DBusCallFlags.NONE, -1)
            bus_id = owner.unpack()[0]
            reply = connection.call_sync(
                "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                "GetConnectionUnixProcessID", GLib.Variant("(s)", (bus_id,)),
                GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, -1)
            pid = reply.unpack()[0]
            raw = Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode("utf-8", "replace")
        except (GLib.GError, OSError, ValueError) as error:
            self.log(f"owner check failed: {error}")
            return False
        if not marker:
            return False
        return marker in raw

    def on_name_lost(self, connection, name) -> None:
        if self.stopping:
            return
        if connection is None:
            # The session bus connection itself closed (logout, bus restart):
            # everything is gone, but the shell may still be alive. Exit
            # retryably so a healthy shell takes the name back.
            self.log("session bus connection closed; standing down")
            self.exit_code = 0
            self.request_stop()
            return
        if self._owner_is_sibling(connection, str(name)):
            self.log("org.freedesktop.ScreenSaver is served by a sibling; standing down")
            self.exit_code = 0
        else:
            self.log("org.freedesktop.ScreenSaver held by a foreign owner; standing down")
            self.exit_code = EXIT_FOREIGN
        self.request_stop()

    def request_stop(self) -> None:
        if self.stopping:
            return
        self.stopping = True
        self.holds.clear()
        self.sync_stay_awake()
        self.publish()
        if self.loop.is_running():
            self.loop.quit()

    def on_stop(self, *_args) -> bool:
        self.request_stop()
        return GLib.SOURCE_REMOVE

    @staticmethod
    def _shell_alive(pid: int) -> bool:
        try:
            fields = Path(f"/proc/{pid}/stat").read_text().split()
            return fields[2] != "Z"  # zombie is dead for our purposes
        except (OSError, IndexError):
            return False

    def _init_watch_pid(self) -> int:
        """The shell pid. The launching shell passes its own pid as argv[1]
        (a handshake that dodges the fork race: a parent dying before the
        child reads getppid() would otherwise leave the child watching its
        own reparent-target for the rest of its life)."""
        if len(sys.argv) > 1:
            try:
                pid = int(sys.argv[1])
            except ValueError:
                return os.getppid()
            if pid > 0:
                return pid
        return os.getppid()

    def _check_parent(self) -> bool:
        """Exit soon after the shell that started us is gone; Quickshell does
        not reliably kill this child, and an orphaned daemon keeps owning
        org.freedesktop.ScreenSaver, which makes every future shell instance
        stand down."""
        if self.stopping:
            return GLib.SOURCE_REMOVE
        if self._shell_alive(self.watch_pid):
            return GLib.SOURCE_CONTINUE
        self.log(f"watch pid {self.watch_pid} is gone (shell died); standing down")
        self.request_stop()
        return GLib.SOURCE_REMOVE

    def _heartbeat(self) -> bool:
        """Defense in-depth for stale daemons.

        Periodically re-syncs state (so a clobbered stay-awake under an
        active hold is recreated within a minute) and emits a minimal line:
        as soon as the reader (the shell plugin instance) is gone, the write
        fails and this copy stands down instead of squatting on the name.
        """
        try:
            self.sync_stay_awake()
        except Exception as error:  # noqa: BLE001 - a timer must not kill the loop
            self.log(f"heartbeat sync failed: {error}")
        self.publish_heartbeat()
        return GLib.SOURCE_CONTINUE if not self.stopping else GLib.SOURCE_REMOVE

    def run(self) -> int:
        if not trusted_interpreter(TRUSTED_PYTHON) or not trusted_interpreter(os.path.realpath(sys.executable)):
            self.log("refusing untrusted interpreter")
            return 1
        GLib.timeout_add_seconds(3, self._check_parent)
        GLib.timeout_add_seconds(30, self._heartbeat)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, self.on_stop)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, self.on_stop)
        Gio.bus_own_name(
            Gio.BusType.SESSION,
            SCREENSAVER_NAME,
            Gio.BusNameOwnerFlags.ALLOW_REPLACEMENT | Gio.BusNameOwnerFlags.DO_NOT_QUEUE,
            self.on_bus_acquired,
            self.on_name_acquired,
            self.on_name_lost,
        )
        if not self.stopping:
            self.loop.run()
        return self.exit_code


if __name__ == "__main__":
    if "--check-interpreter" in sys.argv:
        sys.exit(check_interpreter())
    sys.exit(IdleInhibitDaemon().run())
